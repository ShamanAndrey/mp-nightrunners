<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NightRunnersMP</AssemblyName>
    <Version>0.4.0</Version>
    <RootNamespace>NightRunnersMP</RootNamespace>
    <GameDir>D:\itch\night-runners-private-alpha</GameDir>
    <!-- Second install (Steam Prologue); deployed to as well when present. Same interop API, so one build serves both. -->
    <PrologueDir>D:\SteamLibrary\steamapps\common\NIGHT-RUNNERS PROLOGUE</PrologueDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
    <Compile Include="..\shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- MelonLoader ships AssetsTools.NET itself; shipping our own copy would clash at load time -->
    <Reference Include="$(GameDir)\MelonLoader\net6\AssetsTools.NET.dll" Private="false" />
    <!-- Generated by MelonLoader on first game launch; build will fail until then -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- Mod DLL goes to Mods\, its dependencies to UserLibs\ (MelonLoader resolves from there).
       A running game locks the DLL; that only warns, so packaging still works. -->
  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="$(OutDir)LiteNetLib.dll;$(MSBuildProjectDirectory)\..\installer\UserLibs\classdata.tpk" DestinationFolder="$(GameDir)\UserLibs" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Copy Condition="Exists('$(PrologueDir)\MelonLoader')" SourceFiles="$(TargetPath)" DestinationFolder="$(PrologueDir)\Mods" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Copy Condition="Exists('$(PrologueDir)\MelonLoader')" SourceFiles="$(OutDir)LiteNetLib.dll;$(MSBuildProjectDirectory)\..\installer\UserLibs\classdata.tpk" DestinationFolder="$(PrologueDir)\UserLibs" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Message Text="Deploy attempted to $(GameDir) (a warning above means the game is running; close it and rebuild, or copy bin\Release\$(AssemblyName).dll by hand)" Importance="high" />
  </Target>

</Project>
