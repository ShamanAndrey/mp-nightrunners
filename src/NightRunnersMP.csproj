<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>NightRunnersMP</AssemblyName>
    <Version>0.1.6</Version>
    <RootNamespace>NightRunnersMP</RootNamespace>
    <GameDir>D:\itch\night-runners-private-alpha</GameDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(GameDir)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- Generated by MelonLoader on first game launch; build will fail until then -->
    <Reference Include="$(GameDir)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- Mod DLL goes to Mods\, its dependencies to UserLibs\ (MelonLoader resolves from there).
       A running game locks the DLL; that only warns, so packaging still works. -->
  <Target Name="CopyToGame" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Copy SourceFiles="$(OutDir)LiteNetLib.dll" DestinationFolder="$(GameDir)\UserLibs" ContinueOnError="WarnAndContinue" Retries="2" RetryDelayMilliseconds="500" />
    <Message Text="Deploy attempted to $(GameDir) (a warning above means the game is running; close it and rebuild, or copy bin\Release\$(AssemblyName).dll by hand)" Importance="high" />
  </Target>

</Project>
